page 1707 (
    name: Controles de Producción
    alias: CONTROLES-DE-PRODUCCION
    title: Controles de Producción
    appearance {
        pageTemplate: @standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-2
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region filtros (
        name: Filtros
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
    )

    region rendimiento (
        name: Rendimiento: planificado contra real
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.ser_produccion || '-' || r.nro_produccion orden,
                       r.fec_produccion,
                       decode(r.estado, 'P', 'Pendiente', 'C', 'Confirmada', 'A', 'Anulada') estado,
                       r.cod_formula,
                       r.descripcion articulo,
                       r.cantidad_teorica,
                       r.cantidad_real,
                       r.desvio,
                       r.desvio_porc,
                       r.tolerancia_porc,
                       decode(r.fuera_tolerancia, 'S', 'Fuera de tolerancia', 'OK') control,
                       r.motivo_desvio
                  from prwv_rendimiento_produccion r
                 where r.id_empresa = :P0_ID_EMPRESA
                   and r.fec_produccion between nvl(to_date(:P1707_DESDE), trunc(sysdate) - 30) and nvl(to_date(:P1707_HASTA), trunc(sysdate))
                   and (:P1707_SOLO_PROBLEMAS = 'N' or r.fuera_tolerancia = 'S')
                 order by r.fec_produccion desc, r.nro_produccion desc
                ```
            pageItemsToSubmit: [
                P1707_DESDE
                P1707_HASTA
                P1707_SOLO_PROBLEMAS
            ]
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        reportLayout {
            numberOfRows: 15
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: bottomRight
        }
        messages {
            whenNoDataFound: Sin producciones en el período.
        }

        column ORDEN (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Orden
            }
            layout {
                sequence: 10
            }
        )

        column FEC_PRODUCCION (
