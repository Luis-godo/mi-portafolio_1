    region compras-pendientes (
        name: Compras con marcas de producción pendientes de conversión
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select v.tip_comprobante || ' ' || v.ser_comprobante || '-' || v.nro_comprobante compra,
                       v.fec_comprobante,
                       v.descripcion marca,
                       v.cantidad_ub,
                       v.cantidad_generico,
                       g.descripcion generico
                  from prwv_compras_pend_conversion v
                  join stw_articulos g on g.id = v.id_generico
                 where v.id_empresa = :P0_ID_EMPRESA
                 order by v.fec_comprobante
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        reportLayout {
            numberOfRows: 15
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: bottomRight
        }
        messages {
            whenNoDataFound: No hay compras pendientes de conversión.
        }

        column COMPRA (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Compra
            }
            layout {
                sequence: 10
            }
        )

        column FEC_COMPROBANTE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Fecha
            }
            layout {
                sequence: 20
            }
        )

        column MARCA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Marca comprada
            }
            layout {
                sequence: 30
            }
        )

        column CANTIDAD_UB (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Cantidad (UB marca)
                alignment: end
            }
            layout {
                sequence: 40
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
        )

        column CANTIDAD_GENERICO (
            reportColumnQueryId: 5
            derivedColumn: N
            heading {
                heading: Equivale en genérico
                alignment: end
            }
            layout {
                sequence: 50
