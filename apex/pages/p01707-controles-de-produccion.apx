        )

        column GENERICO (
            reportColumnQueryId: 6
            derivedColumn: N
            heading {
                heading: Genérico
            }
            layout {
                sequence: 60
            }
        )
    )

    region oc-errores (
        name: Órdenes de compra que no respetan las reglas de producción (últimos 180 días)
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select o.tip_comprobante || ' ' || o.ser_comprobante || '-' || o.nro_comprobante orden,
                       o.fec_comprobante,
                       decode(o.ind_produccion, 'S', 'Sí', 'No') produccion,
                       replace(o.errores, chr(10), '<br>') errores
                  from prwv_oc_produccion_errores o
                 where o.id_empresa = :P0_ID_EMPRESA
                 order by o.fec_comprobante desc
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
