    region costos (
        name: Costo de producción frente a la producción anterior
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.ser_produccion || '-' || c.nro_produccion orden,
                       c.fec_produccion,
                       c.descripcion articulo,
                       c.costo_unitario,
                       c.costo_unitario_anterior,
                       c.variacion_porc
                  from prwv_costos_produccion c
                 where c.id_empresa = :P0_ID_EMPRESA
                   and c.fec_produccion between nvl(to_date(:P1707_DESDE), trunc(sysdate) - 30) and nvl(to_date(:P1707_HASTA), trunc(sysdate))
                   and (:P1707_SOLO_PROBLEMAS = 'N' or abs(c.variacion_porc) > nvl(to_number(w_busca_parametro('PD', 'PRW_TOLERANCIA_PORC')), 5))
                 order by abs(nvl(c.variacion_porc, 0)) desc
                ```
            pageItemsToSubmit: [
                P1707_DESDE
                P1707_HASTA
                P1707_SOLO_PROBLEMAS
            ]
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        reportLayout {
            numberOfRows: 15
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: bottomRight
        }
        messages {
            whenNoDataFound: Sin producciones confirmadas en el período.
        }

        column ORDEN (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Orden
            }
            layout {
                sequence: 10
            }
        )

        column FEC_PRODUCCION (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Fecha
            }
            layout {
                sequence: 20
            }
        )

        column ARTICULO (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Artículo
            }
            layout {
                sequence: 30
            }
        )

        column COSTO_UNITARIO (
            reportColumnQueryId: 4
            derivedColumn: N
