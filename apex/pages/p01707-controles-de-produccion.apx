            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: N
        }
    )

    dynamicAction filtrar (
        name: Filtrar
        execution {
            sequence: 10
        }
        when {
            event: change
            selectionType: items
            items: [
                P1707_DESDE
                P1707_HASTA
                P1707_ID_ARTICULO
                P1707_SOLO_PROBLEMAS
            ]
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @rendimiento
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

        action native-refresh-2 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @costos
            }
            execution {
                sequence: 20
                fireOnInit: false
            }
        )

        action native-refresh-3 (
            action: refresh
            affectedElements {
                selectionType: region
                region: @trazabilidad
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
        )

    )

)
