            authorizationScheme: @derechos-consultar
        }
        reportLayout {
            numberOfRows: 15
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: bottomRight
        }
        messages {
            whenNoDataFound: Todas las órdenes respetan las reglas de producción.
        }

        column ORDEN (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Orden de compra
            }
            layout {
                sequence: 10
            }
        )

        column FEC_COMPROBANTE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Fecha
            }
            layout {
                sequence: 20
            }
        )

        column PRODUCCION (
