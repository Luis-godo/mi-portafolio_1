                heading: Problemas
            }
            layout {
                sequence: 40
            }
            security {
                escapeSpecialChars: false
            }
        )
    )

    region config (
        name: Configuración incompleta
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Fórmula ' || f.cod_formula || ' ' || f.comentario objeto,
                       f.cod_articulo || ' - ' || f.descripcion articulo,
                       f.problema
                  from prwv_formulas_incompletas f
                 where f.id_empresa = to_char(:P0_ID_EMPRESA)
                union all
                select 'Artículo de producción', s.cod_articulo || ' - ' || s.descripcion,
                       'Marcado para producción y sin compuesto (no es genérico ni marca)'
                  from prwv_art_produccion_sin_compuesto s
                 where s.id_empresa = :P0_ID_EMPRESA
                union all
                select 'Compuesto', c.cod_articulo || ' - ' || c.descripcion, replace(c.errores, chr(10), '<br>')
                  from prwv_compuestos_con_errores c
                 where c.id_empresa = :P0_ID_EMPRESA
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        reportLayout {
            numberOfRows: 15
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: bottomRight
        }
        messages {
            whenNoDataFound: No hay problemas de configuración.
        }

        column OBJETO (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Objeto
            }
            layout {
                sequence: 10
            }
        )

        column ARTICULO (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Artículo
            }
            layout {
                sequence: 20
            }
        )

        column PROBLEMA (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Problema
            }
            layout {
                sequence: 30
            }
            security {
                escapeSpecialChars: false
            }
        )
    )

    region inconsistencias (
        name: Documentos con posibles inconsistencias de stock
        type: classicReport
