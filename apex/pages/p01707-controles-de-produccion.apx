    region trazabilidad (
        name: Trazabilidad de movimientos del módulo
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select decode(m.tipo_documento, 'CNV', 'Conversión', 'TRF', 'Transferencia', 'PRO', 'Producción')
                       || ' ' || m.nro_documento documento,
                       m.operacion,
                       m.fec_ent_sal,
                       m.nro_ajuste,
                       s.descripcion sucursal,
                       decode(m.ind_ent_sal, 'E', 'Entrada', 'Salida') movimiento,
                       m.cod_articulo || ' - ' || m.descripcion articulo,
                       m.nro_lote,
                       m.cantidad_ub,
                       m.costo_unitario,
                       m.total_costo,
                       m.usuario
                  from prwv_movimientos_modulo m
                  join bsw_sucursales s on s.id = m.id_sucursal
                 where m.id_empresa = :P0_ID_EMPRESA
                   and m.fec_ent_sal between nvl(to_date(:P1707_DESDE), trunc(sysdate) - 30) and nvl(to_date(:P1707_HASTA), trunc(sysdate))
                   and (:P1707_ID_ARTICULO is null or m.id_articulo = :P1707_ID_ARTICULO)
                 order by m.id_entsal_cab desc
                ```
            pageItemsToSubmit: [
                P1707_DESDE
                P1707_HASTA
                P1707_ID_ARTICULO
            ]
        }
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        reportLayout {
            numberOfRows: 25
        }
        componentAppearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
            displayPosition: bottomRight
        }
        messages {
            whenNoDataFound: Sin movimientos en el período.
        }

