page 1705 (
    name: Carga de Transferencia
    alias: CARGA-DE-TRANSFERENCIA
    title: Transferencia de Artículos
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1300
        height: 820
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-2
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 40
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region transferencia (
        name: Transferencia
        type: form
        source {
            location: localDatabase
            tableName: PRW_TRANSFERENCIA_CAB
            whereClause: ID_EMPRESA = :P0_ID_EMPRESA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region lineas (
        name: Líneas (origen y destino)
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: PRW_TRANSFERENCIA_DET
            whereClause: ID_TRANSFERENCIA = :P1705_ID
            pageItemsToSubmit: P1705_ID
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: Lineas
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: actionsMenu
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 20
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
        )

        column ID_TRANSFERENCIA (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_TRANSFERENCIA
                dataType: number
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
            }
            default {
                type: expression
                plsqlExpression: :P0_ID_EMPRESA
            }
        )

        column NRO_ORDEN (
            type: numberField
            heading {
                heading: Nº
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: NRO_ORDEN
                dataType: number
            }
        )

        column ID_ARTICULO (
            type: popupLov
            heading {
                heading: Artículo origen
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sharedComponent
                lov: @lv-articulos-descripcion
            }
            layout {
                sequence: 70
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_ARTICULO
                dataType: number
            }
        )

        column ID_LOTE (
            type: selectList
            heading {
                heading: Lote
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select l.nro_lote || nvl2(l.fec_vencimiento, ' (vence ' || to_char(l.fec_vencimiento, 'dd/mm/yyyy') || ')', null) d,
                           l.id r
                      from stw_lotes l
                     where l.id_articulo = :ID_ARTICULO
                       and l.id_empresa = :P0_ID_EMPRESA
                     order by l.nro_lote
                    ```
                displayNullValue: true
                nullDisplayValue: Lote por defecto
            }
            cascadingLov {
                parentColumns: ID_ARTICULO
                itemsToSubmit: ID_ARTICULO
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: ID_LOTE
                dataType: number
            }
        )

        column ID_UNIDAD_MEDIDA (
            type: selectList
            heading {
                heading: UM
            }
            lov {
                type: sharedComponent
                lov: @relaciones-um-lv
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: ID_ARTICULO
                itemsToSubmit: ID_ARTICULO
            }
            layout {
                sequence: 90
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_UNIDAD_MEDIDA
                dataType: number
            }
        )

        column CANTIDAD (
            type: numberField
            heading {
                heading: Cantidad
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: CANTIDAD
                dataType: number
            }
        )

        column CANTIDAD_UB (
            type: numberField
            heading {
                heading: Cantidad (UB)
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                databaseColumn: CANTIDAD_UB
                dataType: number
            }
            readOnly {
                type: always
            }
        )

        column COSTO_UNITARIO (
            type: numberField
            heading {
                heading: Costo unit. (UB)
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                databaseColumn: COSTO_UNITARIO
                dataType: number
            }
            readOnly {
                type: always
            }
        )

        column COSTO_TOTAL (
            type: numberField
            heading {
                heading: Costo total
                alignment: end
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990
            }
            source {
                databaseColumn: COSTO_TOTAL
                dataType: number
            }
            readOnly {
                type: always
            }
        )

        column ID_ARTICULO_CONV (
            type: popupLov
            heading {
                heading: Artículo destino (vacío = el mismo)
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sharedComponent
                lov: @lv-articulos-descripcion
            }
            layout {
                sequence: 200
            }
            source {
                databaseColumn: ID_ARTICULO_CONV
                dataType: number
            }
        )

        column ID_LOTE_CONV (
            type: selectList
            heading {
                heading: Lote destino
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select l.nro_lote || nvl2(l.fec_vencimiento, ' (vence ' || to_char(l.fec_vencimiento, 'dd/mm/yyyy') || ')', null) d,
                           l.id r
                      from stw_lotes l
                     where l.id_articulo = nvl(:ID_ARTICULO_CONV, :ID_ARTICULO)
                       and l.id_empresa = :P0_ID_EMPRESA
                     order by l.nro_lote
                    ```
                displayNullValue: true
                nullDisplayValue: Lote por defecto
            }
            cascadingLov {
                parentColumns: ID_ARTICULO_CONV
                itemsToSubmit: [
                    ID_ARTICULO_CONV
                    ID_ARTICULO
                ]
            }
            layout {
                sequence: 210
            }
            source {
                databaseColumn: ID_LOTE_CONV
                dataType: number
            }
        )

        column ID_UNIDAD_MEDIDA_CONV (
            type: selectList
            heading {
                heading: UM destino
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select um.descripcion || '(' || rd.mult || '/' || rd.divisor || ')' d, um.id r
                      from stw_articulos ar
                      join stw_relaciones_cab rc on rc.id = ar.id_relacion_um
                      join stw_relaciones rd on rd.id_unidad_rel = rc.id
                      join stw_unidades_medida um on um.id = rd.id_relacion_um
                     where ar.id = :ID_ARTICULO_CONV
                    ```
                displayNullValue: true
                nullDisplayValue: Unidad base
            }
            cascadingLov {
                parentColumns: ID_ARTICULO_CONV
                itemsToSubmit: ID_ARTICULO_CONV
            }
            layout {
                sequence: 220
            }
            source {
                databaseColumn: ID_UNIDAD_MEDIDA_CONV
                dataType: number
            }
        )

        column CANTIDAD_CONV (
            type: numberField
            heading {
                heading: Cantidad destino
                alignment: end
            }
            layout {
                sequence: 230
                columnAlignment: end
            }
            source {
                databaseColumn: CANTIDAD_CONV
                dataType: number
            }
        )

        column CANTIDAD_UB_CONV (
            type: numberField
            heading {
                heading: Destino (UB)
                alignment: end
            }
            layout {
                sequence: 240
                columnAlignment: end
            }
            source {
                databaseColumn: CANTIDAD_UB_CONV
                dataType: number
            }
            readOnly {
                type: always
            }
        )
    )

    pageItem P1705_ID (
        type: hidden
        layout {
            sequence: 10
            region: @transferencia
            slot: regionBody
        }
        source {
            formRegion: @transferencia
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1705_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @transferencia
            slot: regionBody
        }
        source {
            formRegion: @transferencia
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_EMPRESA
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1705_ESTADO (
        type: hidden
        layout {
            sequence: 30
            region: @transferencia
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: select estado from prw_transferencia_cab where id = :P1705_ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1705_RESUMEN (
        type: displayOnly
        label {
            label: Comprobante
        }
        layout {
            sequence: 40
            region: @transferencia
            slot: regionBody
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select c.tip_comprobante || ' ' || c.ser_comprobante || '-' || c.nro_comprobante
                       || ' · ' || decode(c.estado, 'P', 'Pendiente', 'C', 'Confirmada', 'A', 'Anulada')
                       || ' · costo ' || to_char(nvl((select sum(d.costo_total)
                                                        from prw_transferencia_det d
                                                       where d.id_transferencia = c.id), 0), 'fm999G999G999G990')
                  from prw_transferencia_cab c
                 where c.id = :P1705_ID
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1705_ID
        }
    )

    pageItem P1705_FEC_COMPROBANTE (
        type: datePicker
        label {
            label: Fecha
        }
        layout {
            sequence: 50
            region: @transferencia
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @transferencia
            column: FEC_COMPROBANTE
            dataType: date
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P1705_ESTADO, 'P') != 'P'
        }
    )

    pageItem P1705_ID_SUCURSAL (
        type: selectList
        label {
            label: Sucursal de salida
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @transferencia
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @transferencia
            column: ID_SUCURSAL
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_SUCURSAL
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P1705_ESTADO, 'P') != 'P'
        }
    )

    pageItem P1705_ID_SUCURSAL_ENT (
        type: selectList
        label {
            label: Sucursal de entrada
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @transferencia
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @transferencia
            column: ID_SUCURSAL_ENT
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_SUCURSAL
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P1705_ESTADO, 'P') != 'P'
        }
    )

    pageItem P1705_ID_COMPRA_CAB (
        type: selectList
        label {
            label: Corrige la compra (opcional)
        }
        lov {
            type: sqlQuery
            sqlQuery:
                ```sql
                select c.tip_comprobante || ' ' || c.ser_comprobante || '-' || c.nro_comprobante
                       || ' (' || to_char(c.fec_comprobante, 'dd/mm/yyyy') || ')' d,
                       c.id r
                  from cmw_compras_cabecera c
                 where c.id_empresa = :P0_ID_EMPRESA
                   and c.estado = 'C'
                   and c.fec_comprobante >= trunc(sysdate) - 120
                 order by c.fec_comprobante desc
                ```
            displayNullValue: true
            nullDisplayValue: - Ninguna: costo promedio vigente -
        }
        layout {
            sequence: 80
            region: @transferencia
            slot: regionBody
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @transferencia
            column: ID_COMPRA_CAB
            dataType: number
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P1705_ESTADO, 'P') != 'P'
        }
    )

    pageItem P1705_MOTIVO (
        type: textarea
        label {
            label: Motivo
        }
        layout {
            sequence: 110
            region: @transferencia
            slot: regionBody
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @transferencia
            column: MOTIVO
            dataType: varchar2
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P1705_ESTADO, 'P') != 'P'
        }
    )

    pageItem P1705_MOTIVO_ANULACION (
        type: textarea
        label {
            label: Motivo de la anulación
        }
        layout {
            sequence: 120
            region: @transferencia
            slot: regionBody
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P1705_ESTADO
            value: C
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cerrar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
            cssClasses: t-Button--danger
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P1705_ESTADO
            value: P
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button anular (
        buttonName: ANULAR
        label: Anular
        layout {
            sequence: 30
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-ban
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Se revertirán los movimientos de stock y el costo del destino. ¿Anular la transferencia?
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P1705_ESTADO
            value: C
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button calcular (
        buttonName: CALCULAR
        label: Guardar
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-save
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: item=value
            item: P1705_ESTADO
            value: P
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    button confirmar (
        buttonName: CONFIRMAR
        label: Confirmar
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
            requiresConfirmation: true
        }
        confirmation {
            message: Saldrá el stock de origen y entrará el de destino. ¿Confirmar la transferencia?
            style: warning
        }
        serverSideCondition {
            type: item=value
            item: P1705_ESTADO
            value: P
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 60
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P1705_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    validation motivo-anulacion (
        name: Motivo de anulación
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P1705_MOTIVO_ANULACION
        }
        error {
            errorMessage: Indique el motivo de la anulación.
            displayLocation: inlineWithFieldAndInNotification
            associatedItem: @P1705_MOTIVO_ANULACION
        }
        serverSideCondition {
            whenButtonPressed: @anular
        }
    )

    process initialize-form (
        name: Inicializar formulario
        type: formInitialization
        formRegion: @transferencia
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Guardar cabecera
        type: formAutoRowProcessing
        formRegion: @transferencia
        execution {
            sequence: 10
        }
        error {
            errorMessage: No se pudo guardar la transferencia: #SQLERRM_TEXT#
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,DELETE,CALCULAR,CONFIRMAR
        }
    )

    process setear-id-lineas (
        name: Asignar transferencia a las líneas
        type: executeCode
        editableRegion: @lineas
        source {
            plsqlCode: :ID_TRANSFERENCIA := :P1705_ID;
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,CALCULAR,CONFIRMAR
        }
    )

    process guardar-lineas (
        name: Guardar líneas
        type: interactiveGridAutoRowProcessing
        editableRegion: @lineas
        execution {
            sequence: 30
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,CALCULAR,CONFIRMAR
        }
    )

    process confirmar (
        name: Confirmar transferencia
        type: executeCode
        source {
            plsqlCode: prwk_produccion.confirmar_transferencia(:P1705_ID);
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Transferencia confirmada.
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
        }
    )

    process anular (
        name: Anular transferencia
        type: executeCode
        source {
            plsqlCode: prwk_produccion.anular_transferencia(:P1705_ID, :P1705_MOTIVO_ANULACION);
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Transferencia anulada: se revirtieron los movimientos.
        }
        serverSideCondition {
            whenButtonPressed: @anular
        }
    )

    process close-dialog (
        name: Cerrar diálogo
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,CONFIRMAR,ANULAR
        }
    )

)
