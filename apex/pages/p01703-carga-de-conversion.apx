            }
        )

        column CANTIDAD_UB (
            type: numberField
            heading {
                heading: Cantidad (UB)
                alignment: end
            }
            layout {
                sequence: 150
                columnAlignment: end
            }
            source {
                databaseColumn: CANTIDAD_UB
                dataType: number
