page 1703 (
    name: Carga de Conversión
    alias: CARGA-DE-CONVERSION
    title: Conversión
    appearance {
        pageMode: modalDialog
        dialogTemplate: @modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        width: 1300
        height: 820
        chained: false
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        authorizationScheme: @derecho-pagina-2
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 40
            slot: dialogFooter
        }
        appearance {
            template: @buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region conversion (
        name: Conversión
        type: form
        source {
            location: localDatabase
            tableName: PRW_CONVERSIONES_CAB
            whereClause: ID_EMPRESA = :P0_ID_EMPRESA
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        security {
            authorizationScheme: @derechos-consultar
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        editAuthorization {
            add: @derechos-insertar-2
            update: @derechos-actualizar-2
            delete: @derechos-borrar-2
        }
    )

    region insumos (
        name: Insumos consumidos
        type: interactiveGrid
        source {
            location: localDatabase
            tableName: PRW_CONVERSIONES_ING
            whereClause: ID_CONVERSION = :P1703_ID
            pageItemsToSubmit: P1703_ID
        }
        layout {
            sequence: 20
            slot: contentBody
        }
        appearance {
            template: @standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: Insumos
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
        toolbar {
            controls: actionsMenu
        }

        savedReport primary (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }
        )

        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 10
            }
        )

        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 20
            }
        )

        column ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: ID
                dataType: number
                primaryKey: true
            }
        )

        column ID_CONVERSION (
            type: hidden
            layout {
                sequence: 40
            }
            source {
                databaseColumn: ID_CONVERSION
                dataType: number
            }
        )

        column ID_EMPRESA (
            type: hidden
            layout {
                sequence: 50
            }
            source {
                databaseColumn: ID_EMPRESA
                dataType: number
            }
            default {
                type: expression
                plsqlExpression: :P0_ID_EMPRESA
            }
        )

        column NRO_ORDEN (
            type: numberField
            heading {
                heading: Nº
                alignment: end
            }
            layout {
                sequence: 60
                columnAlignment: end
            }
            source {
                databaseColumn: NRO_ORDEN
                dataType: number
            }
        )

        column ID_ARTICULO (
            type: popupLov
            heading {
                heading: Artículo
            }
            settings {
                displayAs: modalDialog
            }
            lov {
                type: sharedComponent
                lov: @lv-articulos-descripcion
            }
            layout {
                sequence: 70
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_ARTICULO
                dataType: number
            }
        )

        column ID_LOTE (
            type: selectList
            heading {
                heading: Lote
            }
            lov {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select l.nro_lote || nvl2(l.fec_vencimiento, ' (vence ' || to_char(l.fec_vencimiento, 'dd/mm/yyyy') || ')', null) d,
                           l.id r
                      from stw_lotes l
                     where l.id_articulo = :ID_ARTICULO
                       and l.id_empresa = :P0_ID_EMPRESA
                     order by l.nro_lote
                    ```
                displayNullValue: true
                nullDisplayValue: Lote por defecto
            }
            cascadingLov {
                parentColumns: ID_ARTICULO
                itemsToSubmit: ID_ARTICULO
            }
            layout {
                sequence: 80
            }
            source {
                databaseColumn: ID_LOTE
                dataType: number
            }
        )

        column ID_UNIDAD_MEDIDA (
            type: selectList
            heading {
                heading: UM
            }
            lov {
                type: sharedComponent
                lov: @relaciones-um-lv
                displayNullValue: false
            }
            cascadingLov {
                parentColumns: ID_ARTICULO
                itemsToSubmit: ID_ARTICULO
            }
            layout {
                sequence: 90
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: ID_UNIDAD_MEDIDA
                dataType: number
            }
        )

        column CANTIDAD (
            type: numberField
            heading {
                heading: Cantidad
                alignment: end
            }
            layout {
                sequence: 100
                columnAlignment: end
            }
            validation {
                valueRequired: true
            }
            source {
                databaseColumn: CANTIDAD
                dataType: number
            }
        )

        column CANTIDAD_UB (
            type: numberField
            heading {
                heading: Cantidad (UB)
                alignment: end
            }
            layout {
                sequence: 110
                columnAlignment: end
            }
            source {
                databaseColumn: CANTIDAD_UB
                dataType: number
            }
            readOnly {
                type: always
            }
        )

        column COSTO_UNITARIO (
            type: numberField
            heading {
                heading: Costo unit. (UB)
                alignment: end
            }
            layout {
                sequence: 120
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D00
            }
            source {
                databaseColumn: COSTO_UNITARIO
                dataType: number
            }
            readOnly {
                type: always
            }
        )

        column COSTO_TOTAL (
            type: numberField
            heading {
                heading: Costo total
                alignment: end
            }
            layout {
                sequence: 130
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990
            }
            source {
                databaseColumn: COSTO_TOTAL
                dataType: number
            }
            readOnly {
                type: always
            }
        )

        column ID_COMPRA_DET (
            type: hidden
            layout {
                sequence: 140
            }
            source {
                databaseColumn: ID_COMPRA_DET
                dataType: number
            }
        )
    )

