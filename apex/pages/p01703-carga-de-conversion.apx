    pageItem P1703_ID (
        type: hidden
        layout {
            sequence: 10
            region: @conversion
            slot: regionBody
        }
        source {
            formRegion: @conversion
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1703_ID_EMPRESA (
        type: hidden
        layout {
            sequence: 20
            region: @conversion
            slot: regionBody
        }
        source {
            formRegion: @conversion
            column: ID_EMPRESA
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_EMPRESA
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1703_ESTADO (
        type: hidden
        layout {
            sequence: 30
            region: @conversion
            slot: regionBody
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery: select estado from prw_conversiones_cab where id = :P1703_ID
            used: always
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P1703_RESUMEN (
        type: displayOnly
        label {
            label: Comprobante
        }
        layout {
            sequence: 40
            region: @conversion
            slot: regionBody
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select c.tip_comprobante || ' ' || c.ser_comprobante || '-' || c.nro_comprobante
                       || ' · ' || decode(c.estado, 'P', 'Pendiente', 'C', 'Confirmada', 'A', 'Anulada')
                       || decode(c.origen, 'R', ' · generada desde una compra', null)
                       || ' · costo insumos ' || to_char(nvl(c.costo_insumos, 0), 'fm999G999G999G990')
                       || ' · costo total ' || to_char(nvl(c.costo_total, 0), 'fm999G999G999G990')
                  from prw_conversiones_cab c
                 where c.id = :P1703_ID
                ```
            used: always
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P1703_ID
        }
    )

    pageItem P1703_FEC_COMPROBANTE (
        type: datePicker
        label {
            label: Fecha
        }
        layout {
            sequence: 50
            region: @conversion
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @conversion
            column: FEC_COMPROBANTE
            dataType: date
        }
        default {
            type: expression
            plsqlExpression: trunc(sysdate)
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P1703_ESTADO, 'P') != 'P'
        }
    )

    pageItem P1703_ID_SUCURSAL (
        type: selectList
        label {
            label: Sucursal
        }
        lov {
            type: sharedComponent
            lov: @lv-sucursales
            displayNullValue: false
        }
        layout {
            sequence: 60
            region: @conversion
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @conversion
            column: ID_SUCURSAL
            dataType: number
        }
        default {
            type: expression
            plsqlExpression: :P0_ID_SUCURSAL
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P1703_ESTADO, 'P') != 'P'
        }
    )

    pageItem P1703_TIPO_COSTO (
        type: selectList
        label {
            label: Tipo de costo
        }
        lov {
            type: staticValues
            staticValues: STATIC:Con costo (el valor pasa a los resultados);C,Sin traslado automático (subproductos al costo informado);S
            displayNullValue: false
        }
        layout {
            sequence: 70
            region: @conversion
            slot: regionBody
            startNewRow: false
            columnSpan: 4
        }
        appearance {
            template: @required
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @conversion
            column: TIPO_COSTO
            dataType: varchar2
        }
        default {
            type: static
            staticValue: C
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P1703_ESTADO, 'P') != 'P'
        }
    )

    pageItem P1703_IND_DESPOSTE (
        type: checkbox
        label {
            label: Desposte
        }
        settings {
            useDefaults: false
            checkedValue: S
            uncheckedValue: N
        }
        layout {
            sequence: 80
            region: @conversion
            slot: regionBody
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @conversion
            column: IND_DESPOSTE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: N
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P1703_ESTADO, 'P') != 'P'
        }
    )

    pageItem P1703_PORC_GASTOS_ADM (
        type: numberField
        label {
