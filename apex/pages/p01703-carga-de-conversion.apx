            dataType: number
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P1703_ESTADO, 'P') != 'P'
        }
    )

    pageItem P1703_TOTAL_GASTOS_ADM (
        type: numberField
        label {
            label: Gastos (importe)
        }
        layout {
            sequence: 100
            region: @conversion
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @conversion
            column: TOTAL_GASTOS_ADM
            dataType: number
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P1703_ESTADO, 'P') != 'P'
        }
    )

    pageItem P1703_MOTIVO (
        type: textarea
        label {
            label: Motivo / observación
        }
        layout {
            sequence: 110
            region: @conversion
            slot: regionBody
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @conversion
            column: MOTIVO
            dataType: varchar2
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P1703_ESTADO, 'P') != 'P'
        }
    )

    pageItem P1703_MOTIVO_ANULACION (
        type: textarea
        label {
            label: Motivo de la anulación
        }
        layout {
            sequence: 120
            region: @conversion
            slot: regionBody
        }
        appearance {
            template: @optional
            templateOptions: #DEFAULT#
        }
        serverSideCondition {
            type: item=value
            item: P1703_ESTADO
            value: C
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cerrar
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button delete (
        buttonName: DELETE
        label: Borrar
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text
            templateOptions: #DEFAULT#
            cssClasses: t-Button--danger
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P1703_ESTADO
            value: P
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button anular (
        buttonName: ANULAR
        label: Anular
        layout {
            sequence: 30
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            cssClasses: t-Button--danger
            icon: fa-ban
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            requiresConfirmation: true
        }
        confirmation {
            message: Se revertirán los movimientos de stock y el costo de los resultados. ¿Anular la conversión?
            style: danger
        }
        serverSideCondition {
            type: item=value
            item: P1703_ESTADO
            value: C
        }
        security {
            authorizationScheme: @derechos-borrar-2
        }
    )

    button calcular (
        buttonName: CALCULAR
        label: Guardar y calcular costos
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-calculator
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: item=value
            item: P1703_ESTADO
            value: P
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    button confirmar (
        buttonName: CONFIRMAR
        label: Confirmar
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-check
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
            requiresConfirmation: true
        }
        confirmation {
            message: Se moverá el stock de insumos y resultados y se actualizará el costo. ¿Confirmar la conversión?
            style: warning
        }
        serverSideCondition {
            type: item=value
            item: P1703_ESTADO
            value: P
        }
        security {
            authorizationScheme: @derechos-actualizar-2
        }
    )

    button create (
        buttonName: CREATE
        label: Crear
        layout {
            sequence: 60
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @text-with-icon
            hot: true
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-plus
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P1703_ID
        }
        security {
            authorizationScheme: @derechos-insertar-2
        }
    )

    validation motivo-anulacion (
        name: Motivo de anulación
        execution {
            sequence: 10
        }
        validation {
            type: itemIsNotNull
            item: P1703_MOTIVO_ANULACION
        }
        error {
            errorMessage: Indique el motivo de la anulación.
            displayLocation: inlineWithFieldAndInNotification
            associatedItem: @P1703_MOTIVO_ANULACION
        }
        serverSideCondition {
            whenButtonPressed: @anular
        }
    )

    process initialize-form (
        name: Inicializar formulario
        type: formInitialization
        formRegion: @conversion
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Guardar cabecera
        type: formAutoRowProcessing
        formRegion: @conversion
        execution {
            sequence: 10
        }
        error {
            errorMessage: No se pudo guardar la conversión: #SQLERRM_TEXT#
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,DELETE,CALCULAR,CONFIRMAR
        }
    )

    process setear-id-insumos (
        name: Asignar conversión a los insumos
        type: executeCode
        editableRegion: @insumos
        source {
            plsqlCode: :ID_CONVERSION := :P1703_ID;
        }
        execution {
            sequence: 20
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,CALCULAR,CONFIRMAR
        }
    )

    process guardar-insumos (
        name: Guardar insumos
        type: interactiveGridAutoRowProcessing
        editableRegion: @insumos
        execution {
            sequence: 30
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,CALCULAR,CONFIRMAR
        }
    )

    process setear-id-resultados (
        name: Asignar conversión a los resultados
        type: executeCode
        editableRegion: @resultados
        source {
            plsqlCode: :ID_CONVERSION := :P1703_ID;
        }
        execution {
            sequence: 40
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,CALCULAR,CONFIRMAR
        }
    )

    process guardar-resultados (
        name: Guardar resultados
        type: interactiveGridAutoRowProcessing
        editableRegion: @resultados
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,CALCULAR,CONFIRMAR
        }
    )

    process calcular (
        name: Calcular costos
        type: executeCode
        source {
            plsqlCode: prwk_produccion.calcular_conversion(:P1703_ID);
        }
        execution {
            sequence: 60
        }
        successMessage {
            successMessage: Costos calculados. Revíselos antes de confirmar.
        }
        serverSideCondition {
            whenButtonPressed: @calcular
        }
    )

    process confirmar (
        name: Confirmar conversión
        type: executeCode
        source {
            plsqlCode: prwk_produccion.confirmar_conversion(:P1703_ID);
        }
        execution {
            sequence: 70
        }
        successMessage {
            successMessage: Conversión confirmada: stock y costos actualizados.
        }
        serverSideCondition {
            whenButtonPressed: @confirmar
        }
    )

    process anular (
        name: Anular conversión
        type: executeCode
        source {
            plsqlCode: prwk_produccion.anular_conversion(:P1703_ID, :P1703_MOTIVO_ANULACION);
        }
        execution {
            sequence: 80
        }
        successMessage {
            successMessage: Conversión anulada: se revirtieron los movimientos.
        }
        serverSideCondition {
            whenButtonPressed: @anular
        }
    )

    process close-dialog (
        name: Cerrar diálogo
        type: closeDialog
        execution {
            sequence: 90
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,CONFIRMAR,ANULAR
        }
    )

)
