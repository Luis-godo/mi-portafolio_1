                heading: Principal
            }
            lov {
                type: staticValues
                staticValues: STATIC:Sí;S,No;N
                displayNullValue: false
            }
            layout {
                sequence: 100
            }
            source {
                databaseColumn: ARTICULO_PRINCIPAL
                dataType: varchar2
            }
